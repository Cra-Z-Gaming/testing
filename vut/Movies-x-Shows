<!DOCTYPE html>
<html>
<head>
<title>Jellyfin Library</title>
<style>
* { box-sizing: border-box; }

body {
    font-family: Arial, sans-serif;
    background: #111;
    color: white;
    padding: 20px;
    margin: 0;
}

h1 {
    margin-top: 30px;
    font-size: 1.4em;
}

/* ---------- Tabs ---------- */
.tabs {
    display: flex;
    gap: 10px;
    margin-bottom: 10px;
    border-bottom: 1px solid #333;
    padding-bottom: 10px;
}

.tab-btn {
    background: #222;
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 1em;
}

.tab-btn.active {
    background: #4a90d9;
}

.tab-panel { display: none; }
.tab-panel.active { display: block; }

/* ---------- Grid ---------- */
.grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 15px;
}

.card {
    background: #222;
    padding: 10px;
    border-radius: 10px;
    cursor: pointer;
    transition: background 0.15s ease;
}

.card:hover {
    background: #2c2c2c;
}

.card img {
    width: 100%;
    aspect-ratio: 2/3;
    object-fit: cover;
    border-radius: 8px;
    background: #333;
}

.title {
    margin-top: 8px;
    font-weight: bold;
    font-size: 0.9em;
}

/* ---------- Pagination ---------- */
.pagination {
    display: flex;
    align-items: center;
    gap: 15px;
    margin: 15px 0;
}

.pagination button {
    background: #222;
    color: white;
    border: none;
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
}

.pagination button:disabled {
    opacity: 0.4;
    cursor: default;
}

/* ---------- Shows / Seasons / Episodes ---------- */
.back-btn {
    background: #222;
    color: white;
    border: none;
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    margin-bottom: 15px;
}

.episode-card {
    display: flex;
    gap: 12px;
    background: #222;
    padding: 10px;
    border-radius: 10px;
    cursor: pointer;
    margin-bottom: 10px;
    align-items: center;
}

.episode-card:hover {
    background: #2c2c2c;
}

.episode-card img {
    width: 140px;
    border-radius: 6px;
    flex-shrink: 0;
}

.episode-info .ep-title {
    font-weight: bold;
}

.episode-info .ep-number {
    color: #999;
    font-size: 0.85em;
}

/* ---------- Player ---------- */
#playerSection {
    display: none;
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.95);
    z-index: 1000;
    padding: 20px;
    overflow-y: auto;
}

#playerSection.active {
    display: block;
}

#playerTitle {
    margin: 0 0 10px 0;
}

video {
    width: 100%;
    max-height: 75vh;
    background: black;
    border-radius: 8px;
}

.player-controls {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 10px;
    flex-wrap: wrap;
}

.player-controls button {
    background: #222;
    color: white;
    border: none;
    padding: 8px 14px;
    border-radius: 6px;
    cursor: pointer;
}

.player-controls input[type="range"] {
    width: 120px;
}

.close-player {
    float: right;
    background: #c0392b;
}

.loading {
    color: #999;
    padding: 20px 0;
}
</style>
</head>

<body>

<div class="tabs">
    <button class="tab-btn active" id="tabBtnMovies" onclick="switchTab('movies')">Movies</button>
    <button class="tab-btn" id="tabBtnShows" onclick="switchTab('shows')">Shows</button>
</div>

<!-- MOVIES TAB -->
<div id="moviesPanel" class="tab-panel active">
    <h1>Movies</h1>
    <div id="movies" class="grid"></div>
    <div class="pagination">
        <button id="moviesPrevBtn" onclick="changeMoviePage(-1)">Previous</button>
        <span id="moviesPageLabel">Page 1</span>
        <button id="moviesNextBtn" onclick="changeMoviePage(1)">Next</button>
    </div>
</div>

<!-- SHOWS TAB -->
<div id="showsPanel" class="tab-panel">
    <h1 id="showsHeading">Shows</h1>

    <!-- Shows grid (list of series) -->
    <div id="showsListView">
        <div id="shows" class="grid"></div>
    </div>

    <!-- Seasons view -->
    <div id="seasonsView" style="display:none;">
        <button class="back-btn" onclick="backToShows()">&larr; Back to Shows</button>
        <div id="seasons" class="grid"></div>
    </div>

    <!-- Episodes view -->
    <div id="episodesView" style="display:none;">
        <button class="back-btn" onclick="backToSeasons()">&larr; Back to Seasons</button>
        <div id="episodes"></div>
    </div>
</div>

<!-- PLAYER -->
<div id="playerSection">
    <button class="back-btn close-player" onclick="closePlayer()">Close</button>
    <h2 id="playerTitle"></h2>
    <video id="videoPlayer" controls></video>
    <div class="player-controls">
        <button onclick="togglePlayPause()">Play/Pause</button>
        <label>Volume
            <input type="range" id="volumeSlider" min="0" max="1" step="0.05" value="1" oninput="setVolume(this.value)">
        </label>
        <button onclick="toggleFullscreen()">Fullscreen</button>
    </div>
</div>

<script>
/* ==========================
       CONFIG
========================== */

const SERVER_URL = "https://notvlad.duckdns.org";
const API_KEY = "f3e4ee6280524febbc3083624cba2b6e";


/* ==========================
       STATE
========================== */

let currentTab = "movies";

// Movies pagination state
const MOVIES_PAGE_SIZE = 20;
let moviesPage = 1;
let moviesTotalCount = 0;

// Track which tabs have already been loaded so we only fetch once per tab activation
let moviesLoadedPage = null;
let showsLoaded = false;

// Shows navigation state
let currentShowId = null;
let currentShowName = "";
let currentSeasonId = null;


/* ==========================
       API FUNCTIONS
========================== */

/**
 * Generic helper for calling the Jellyfin API with the configured token.
 */
async function jellyfinFetch(path) {
    const url = `${SERVER_URL}${path}`;
    const response = await fetch(url, {
        headers: {
            "X-Emby-Token": API_KEY
        }
    });

    if (!response.ok) {
        throw new Error(`Jellyfin API error ${response.status} for ${path}`);
    }

    return await response.json();
}

/**
 * Fetch items of a given type (Movie/Series), with optional pagination.
 */
async function getItems(type, startIndex, limit) {
    let path = `/Items?IncludeItemTypes=${type}&Recursive=true`;

    if (typeof startIndex === "number") {
        path += `&StartIndex=${startIndex}`;
    }
    if (typeof limit === "number") {
        path += `&Limit=${limit}`;
    }

    return await jellyfinFetch(path);
}

/**
 * Fetch the seasons for a given show.
 */
async function getSeasons(showId) {
    return await jellyfinFetch(`/Shows/${showId}/Seasons`);
}

/**
 * Fetch the episodes for a given show + season.
 */
async function getEpisodes(showId, seasonId) {
    return await jellyfinFetch(`/Shows/${showId}/Episodes?SeasonId=${seasonId}`);
}

/**
 * Build the poster image URL for an item, if it has one.
 */
function imageUrl(item) {
    if (!item.ImageTags || !item.ImageTags.Primary) {
        return "";
    }
    return `${SERVER_URL}/Items/${item.Id}/Images/Primary`;
}

/**
 * Build a direct streaming URL for a video item (movie or episode).
 * Uses Jellyfin's static stream endpoint with the API key as a query param
 * since <video> tags can't send custom headers.
 */
function streamUrl(itemId) {
    return `${SERVER_URL}/Videos/${itemId}/stream?static=true&api_key=${API_KEY}`;
}


/* ==========================
       UI - TABS
========================== */

function switchTab(tab) {
    currentTab = tab;

    document.getElementById("tabBtnMovies").classList.toggle("active", tab === "movies");
    document.getElementById("tabBtnShows").classList.toggle("active", tab === "shows");

    document.getElementById("moviesPanel").classList.toggle("active", tab === "movies");
    document.getElementById("showsPanel").classList.toggle("active", tab === "shows");

    // Only load data for the active tab, and only the first time it's opened
    if (tab === "movies" && moviesLoadedPage === null) {
        loadMoviesPage(1);
    } else if (tab === "shows" && !showsLoaded) {
        loadShows();
    }
}


/* ==========================
       MOVIES
========================== */

async function loadMoviesPage(page) {
    const grid = document.getElementById("movies");
    grid.innerHTML = `<div class="loading">Loading movies...</div>`;

    const startIndex = (page - 1) * MOVIES_PAGE_SIZE;

    const result = await getItems("Movie", startIndex, MOVIES_PAGE_SIZE);

    moviesPage = page;
    moviesLoadedPage = page;
    moviesTotalCount = result.TotalRecordCount || 0;

    displayMovies(result);
    updateMoviesPagination();
}

function displayMovies(result) {
    const grid = document.getElementById("movies");
    grid.innerHTML = "";

    result.Items.forEach(item => {
        const div = document.createElement("div");
        div.className = "card";

        div.innerHTML = `
            ${imageUrl(item) ? `<img src="${imageUrl(item)}">` : ""}
            <div class="title">${item.Name}</div>
        `;

        div.addEventListener("click", () => playItem(item.Id, item.Name));

        grid.appendChild(div);
    });
}

function updateMoviesPagination() {
    const totalPages = Math.max(1, Math.ceil(moviesTotalCount / MOVIES_PAGE_SIZE));

    document.getElementById("moviesPageLabel").textContent = `Page ${moviesPage} of ${totalPages}`;
    document.getElementById("moviesPrevBtn").disabled = moviesPage <= 1;
    document.getElementById("moviesNextBtn").disabled = moviesPage >= totalPages;
}

function changeMoviePage(direction) {
    const totalPages = Math.max(1, Math.ceil(moviesTotalCount / MOVIES_PAGE_SIZE));
    const newPage = moviesPage + direction;

    if (newPage < 1 || newPage > totalPages) return;

    loadMoviesPage(newPage);
}


/* ==========================
       SHOWS
========================== */

async function loadShows() {
    const grid = document.getElementById("shows");
    grid.innerHTML = `<div class="loading">Loading shows...</div>`;

    const result = await getItems("Series");
    showsLoaded = true;

    displayShows(result);
}

function displayShows(result) {
    const grid = document.getElementById("shows");
    grid.innerHTML = "";

    result.Items.forEach(item => {
        const div = document.createElement("div");
        div.className = "card";

        div.innerHTML = `
            ${imageUrl(item) ? `<img src="${imageUrl(item)}">` : ""}
            <div class="title">${item.Name}</div>
        `;

        div.addEventListener("click", () => openShow(item.Id, item.Name));

        grid.appendChild(div);
    });
}

async function openShow(showId, showName) {
    currentShowId = showId;
    currentShowName = showName;

    document.getElementById("showsHeading").textContent = showName;
    document.getElementById("showsListView").style.display = "none";
    document.getElementById("seasonsView").style.display = "block";
    document.getElementById("episodesView").style.display = "none";

    const grid = document.getElementById("seasons");
    grid.innerHTML = `<div class="loading">Loading seasons...</div>`;

    const result = await getSeasons(showId);
    grid.innerHTML = "";

    result.Items.forEach(season => {
        const div = document.createElement("div");
        div.className = "card";

        div.innerHTML = `
            ${imageUrl(season) ? `<img src="${imageUrl(season)}">` : ""}
            <div class="title">${season.Name}</div>
        `;

        div.addEventListener("click", () => openSeason(season.Id, season.Name));

        grid.appendChild(div);
    });
}

async function openSeason(seasonId, seasonName) {
    currentSeasonId = seasonId;

    document.getElementById("showsHeading").textContent = `${currentShowName} - ${seasonName}`;
    document.getElementById("seasonsView").style.display = "none";
    document.getElementById("episodesView").style.display = "block";

    const container = document.getElementById("episodes");
    container.innerHTML = `<div class="loading">Loading episodes...</div>`;

    const result = await getEpisodes(currentShowId, seasonId);
    container.innerHTML = "";

    result.Items.forEach(episode => {
        const div = document.createElement("div");
        div.className = "episode-card";

        div.innerHTML = `
            ${imageUrl(episode) ? `<img src="${imageUrl(episode)}">` : ""}
            <div class="episode-info">
                <div class="ep-number">Episode ${episode.IndexNumber !== undefined ? episode.IndexNumber : "?"}</div>
                <div class="ep-title">${episode.Name}</div>
            </div>
        `;

        div.addEventListener("click", () => playItem(episode.Id, episode.Name));

        container.appendChild(div);
    });
}

function backToShows() {
    document.getElementById("showsHeading").textContent = "Shows";
    document.getElementById("showsListView").style.display = "block";
    document.getElementById("seasonsView").style.display = "none";
    document.getElementById("episodesView").style.display = "none";
}

function backToSeasons() {
    document.getElementById("showsHeading").textContent = currentShowName;
    document.getElementById("seasonsView").style.display = "block";
    document.getElementById("episodesView").style.display = "none";
}


/* ==========================
       PLAYER
========================== */

function playItem(itemId, itemName) {
    const playerSection = document.getElementById("playerSection");
    const video = document.getElementById("videoPlayer");
    const title = document.getElementById("playerTitle");

    title.textContent = itemName;
    video.src = streamUrl(itemId);

    playerSection.classList.add("active");

    video.play().catch(() => {
        // Autoplay might be blocked; user can press play manually.
    });
}

function closePlayer() {
    const playerSection = document.getElementById("playerSection");
    const video = document.getElementById("videoPlayer");

    video.pause();
    video.removeAttribute("src");
    video.load();

    playerSection.classList.remove("active");
}

function togglePlayPause() {
    const video = document.getElementById("videoPlayer");
    if (video.paused) {
        video.play();
    } else {
        video.pause();
    }
}

function setVolume(value) {
    const video = document.getElementById("videoPlayer");
    video.volume = parseFloat(value);
}

function toggleFullscreen() {
    const video = document.getElementById("videoPlayer");
    if (video.requestFullscreen) {
        video.requestFullscreen();
    }
}


/* ==========================
       LOAD
========================== */

// Load the Movies tab by default on startup
switchTab("movies");

</script>

</body>
</html>


